DATABASE_URL=postgres://strata:secret@localhost:5432/strata
HOST=0.0.0.0
PORT=3000

# Nucleus Auth — Backend (optional; omit to run without authentication.
# Backend verifies JWTs against Nucleus JWKS; this admin key is used
# server-side only and must NEVER be exposed to the browser.)
NUCLEUS_API_KEY=sk_live_xxx
NUCLEUS_BASE_URL=https://nucleus.example.com

# Nucleus Auth — Frontend (Vite-exposed; baked into the JS bundle at build
# time. Use the publishable key (pk_*), not the admin API key (sk_*).
# Set VITE_AUTH_ENABLED=false to run the dashboard against the no-auth
# default-tenant backend mode.)
VITE_AUTH_ENABLED=true
VITE_NUCLEUS_PUBLISHABLE_KEY=pk_live_xxx
VITE_NUCLEUS_BASE_URL=https://nucleus.example.com

# Chorus Email (optional — omit to disable email notifications)
RESEND_API_KEY=re_xxx
ALERT_FROM_EMAIL=alerts@strata.dev
