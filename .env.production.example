# --- Database Configuration ---
# Public app user (Least Privilege)
DATABASE_URL=postgres://strata:secure_password@postgres:5432/strata
# Admin user for migrations and tenant provisioning
DATABASE_URL_ADMIN=postgres://postgres:admin_password@postgres:5432/strata
# Password to set for the 'strata' app user during bootstrap
STRATA_APP_PASSWORD=secure_password

# --- AWS / Backup Configuration ---
S3_BACKUP_BUCKET=my-strata-backups
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=secret...
AWS_REGION=us-east-1
BACKUP_INTERVAL=daily
RETENTION_DAYS=7

# --- Integration Keys ---
NUCLEUS_API_KEY=nk_prod_...
RESEND_API_KEY=re_...

# --- Domain & TLS ---
STRATA_DOMAIN=strata-cntm.labs
ACME_EMAIL=admin@example.com
